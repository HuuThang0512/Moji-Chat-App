# @emoji-mart/react khai báo peer dependency react "^16.8 || ^17 || ^18" nhưng dự
# án chạy React 19. Thư viện vẫn hoạt động bình thường, chỉ là tác giả chưa cập
# nhật khoảng phiên bản.
#
# Không có dòng này thì `npm ci` chết với ERESOLVE ở mọi môi trường sạch
# (Docker, CI, máy mới) trong khi máy đã có node_modules từ trước vẫn chạy được.
legacy-peer-deps=true
