# Cổng HTTP của backend
PORT=5001

# development | production
NODE_ENV=development

# Bắt buộc. Chuỗi kết nối MongoDB (local hoặc Atlas)
MONGODB_CONNECTIONSTRING=mongodb://127.0.0.1:27017/moji

# Bắt buộc. Chuỗi bí mật ký access token.
# Sinh chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=thay-bang-chuoi-ngau-nhien-that-dai

# Origin của frontend, dùng cho CORS và Socket.IO
CLIENT_URL=http://localhost:5173

# Tuỳ chọn. Thiếu thì chức năng tải ảnh đại diện trả về 503, phần còn lại vẫn chạy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
