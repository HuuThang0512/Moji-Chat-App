# Cổng HTTP của backend
PORT=5001

# development | production
NODE_ENV=development

# Bắt buộc. Chuỗi kết nối MongoDB (local hoặc Atlas)
MONGODB_CONNECTIONSTRING=mongodb://127.0.0.1:27017/moji

# Bắt buộc. Chuỗi bí mật ký access token.
# Sinh chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=thay-bang-chuoi-ngau-nhien-that-dai

# Origin của frontend, dùng cho CORS và Socket.IO
CLIENT_URL=http://localhost:5173

# Tuỳ chọn. Thiếu thì chức năng tải ảnh đại diện trả về 503, phần còn lại vẫn chạy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Tuỳ chọn. Gửi mail xác minh và khôi phục mật khẩu qua Brevo.
# Thiếu thì hai chức năng đó trả 503, phần còn lại vẫn chạy.
# Lấy khoá tại https://app.brevo.com > SMTP & API > Generate a new API key.
# MAIL_FROM phải là địa chỉ đã xác minh ở mục Senders của Brevo.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Moji

# Tuỳ chọn. Gốc URL dùng để dựng link trong email.
# Để trống ở local là dùng CLIENT_URL. Trên Render không cần đặt vì
# server tự đọc RENDER_EXTERNAL_URL do Render cấp.
APP_URL=

# CHỈ DÙNG Ở MÁY DEV. Đặt =1 để:
#   - mở endpoint GET /api/auth/__dev/last-token cho scripts/smoke.mjs đọc token
#   - in nội dung mail ra console thay vì gửi thật khi chưa cấu hình Brevo
# Không có tác dụng khi NODE_ENV=production, và không bao giờ được đặt trên Render.
EXPOSE_MAIL_TOKENS=
